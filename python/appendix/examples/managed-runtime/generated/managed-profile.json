    "assessed_at": "2026-08-30",
    "assessor": "AP Platform Lead",
    "enforcement": {
      "gate_id": "policy-gate:finance-agents-v1",
      "outside_model": true,
      "checks_action_target": true,
      "checks_manifest_within_profile": true,
      "checks_scope_permissions_credentials_stop": true,
      "containment_check_implementation": "aam-check-containment/0.3.0"
    },
    "evaluation": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/agent-action-manifest/0.4.0/action-manifest.schema.json",
  "title": "Action Manifest",
  "description": "Per-action runtime instance BUILT BY THE GATE from the active Profile and a caller's request. Callers supply the request (operation, targets, parameters, evidence); every authority-bearing field and trusted v0.4 context projection is derived by the gate. Immutable; sealed by the gate. Compatible v0.3.7 base with opt-in v0.4.0 fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "issued_at",
    "review_expires_at",
    "profile_ref",
    "identity",
    "action_target",
    "scope_claim",
    "impact",
    "autonomy_approval",
    "evidence",
    "credentials",
    "data_boundary_claim",
    "audit",
    "outcome_verification",
    "recovery",
    "not_permitted_summary",
    "request_digest",
    "built_by",
    "documented_not_enforced"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.3.6",
        "0.3.7",
        "0.4.0"
      ]
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "integrity": {
      "type": "object",
      "description": "Gate seal over the canonical Manifest body (method gate-hmac-sha256). Present on every gate-built Manifest.",
      "required": [
        "method",
        "key_id",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "profile_ref": {
      "type": "object",
      "description": "The standing profile this instance is derived from and must be contained within.",
      "required": [
        "profile_id",
        "profile_version",
        "conformance_level"
      ],
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "profile_digest": {
          "type": "string",
          "description": "sha256 of the canonical profile body (integrity block excluded). Verified by the containment check when present."
        },
        "conformance_level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ],
          "description": "Copied from the profile; the containment check verifies it matches."
        }
      }
    },
    "identity": {
      "type": "object",
      "description": "Decision 1 (instance). Must equal the profile's identity versions exactly.",
      "required": [
        "agent_name",
        "agent_version",
        "model",
        "prompt",
        "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_name": {
          "type": "string",
          "minLength": 1
        },
        "agent_version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object",
          "required": [
            "provider",
            "identifier"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "identifier": {
              "type": "string"
            }
          }
        },
        "prompt": {
          "type": "object",
          "required": [
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string"
            },
            "hash": {
              "type": "string"
            }
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string"
            },
            "hash": {
              "type": "string"
            }
          }
        }
      }
    },
    "action_target": {
      "type": "object",
      "description": "Decision 2. The exact proposed action, tool/operation, target, and material parameters. One manifest instance binds one action request.",
      "required": [
        "action_id",
        "summary",
        "tool",
        "operation",
        "effect_target"
      ],
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "Plain-language statement of what will happen, including what will not happen."
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true,
          "description": "Material parameters evaluated against the profile's constraints for this operation."
        },
        "parameters_summary": {
          "type": "string"
        },
        "parameters_digest": {
          "type": "string"
        },
        "subject": {
          "type": "object",
          "required": [
            "type",
            "identifier"
          ],
          "additionalProperties": false,
          "description": "What the action is about (e.g., the invoice). Context, not effect.",
          "properties": {
            "type": {
              "type": "string"
            },
            "identifier": {
              "type": "string"
            },
            "system": {
              "type": "string"
            },
            "display": {
              "type": "string"
            }
          }
        },
        "effect_target": {
          "type": "object",
          "required": [
            "type",
            "identifier"
          ],
          "additionalProperties": false,
          "description": "What the action actually affects (e.g., the vendor's email address, the branch, the work order).",
          "properties": {
            "type": {
              "type": "string"
            },
            "identifier": {
              "type": "string"
            },
            "system": {
              "type": "string"
            },
            "class": {
              "type": "string"
            },
            "display": {
              "type": "string",
              "description": "Human-readable form shown on the Card."
            }
          }
        },
        "material_parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {},
              "label": {
                "type": "string",
                "description": "Plain-English label for the Card."
              }
            }
          }
        }
      }
    },
    "scope_claim": {
      "type": "object",
      "description": "Decision 3 (instance). The boundary this action claims; must be within the profile's authority scope.",
      "required": [
        "environment",
        "systems"
      ],
      "additionalProperties": false,
      "properties": {
        "tenant": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "systems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selector": {
          "type": "string"
        },
        "operating_window": {
          "type": "string"
        }
      }
    },
    "impact": {
      "type": "object",
      "description": "Decision 5 (instance). Consequence and blast radius of this action; must be within the profile's impact envelope.",
      "required": [
        "domains",
        "severity",
        "blast_radius",
        "reversible",
        "max_affected_objects"
      ],
      "additionalProperties": false,
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "operational",
              "physical",
              "safety",
              "financial",
              "legal",
              "privacy",
              "security",
              "external_communication",
              "code_or_data_integrity",
              "other"
            ]
          }
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ]
        },
        "blast_radius": {
          "type": "string",
          "minLength": 1
        },
        "bounded_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_affected_objects": {
          "type": "integer",
          "minimum": 0
        },
        "reversible": {
          "type": "boolean"
        },
        "irreversibility_notes": {
          "type": "string"
        }
      }
    },
    "autonomy_approval": {
      "type": "object",
      "description": "Decision 6 (instance). Mode for this action and the approval it requires or has received.",
      "required": [
        "mode",
        "approval_required",
        "one_approval_one_action"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "recommend",
            "request_approval",
            "execute_allowlisted",
            "conditional_autonomy"
          ]
        },
        "approval_required": {
          "type": "boolean"
        },
        "approver_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "one_approval_one_action": {
          "type": "boolean",
          "const": true
        },
        "dual_approval_required": {
          "type": "boolean"
        },
        "approval_timeout_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Decision 7 (instance). Evidence justifying the action, unresolved conflicts, and which untrusted sources were consulted.",
      "required": [
        "evidence_refs",
        "untrusted_sources_present",
        "content_is_data_not_instructions"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional provenance labels aligned to evidence_refs (e.g., live, replay, synthetic, derived, customer_supplied)."
        },
        "unresolved_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "untrusted_sources_present": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Untrusted sources that contributed to this action; must be declared in the profile."
        },
        "content_is_data_not_instructions": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "credentials": {
      "type": "object",
      "description": "Decision 8 (instance). The grant used for this action; must be within the profile's credentials policy.",
      "required": [
        "identity",
        "privileges",
        "ttl_minutes",
        "fail_closed_on_expiry"
      ],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "privileges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ttl_minutes": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "fail_closed_on_expiry": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "data_boundary_claim": {
      "type": "object",
      "description": "Decision 9 (instance). Where inference ran for this action and which fields leave the boundary.",
      "required": [
        "model_hosting",
        "egress_fields"
      ],
      "additionalProperties": false,
      "properties": {
        "model_hosting": {
          "type": "string",
          "enum": [
            "customer_boundary",
            "regional",
            "hosted",
            "other"
          ]
        },
        "egress_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fields that will leave the boundary for this action. Empty when nothing leaves."
        }
      }
    },
    "audit": {
      "type": "object",
      "description": "Decision 10 (instance). Records this action will produce; must include the profile's minimum record set.",
      "required": [
        "records"
      ],
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "log_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "outcome_verification": {
      "type": "object",
      "description": "Decision 11. Observable post-conditions that define success. Tool success is not outcome success.",
      "required": [
        "expected_postconditions",
        "completion_rule",
        "on_failure",
        "verification_tests",
        "max_observation_age_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "expected_postconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "completion_rule": {
          "type": "string",
          "enum": [
            "all_postconditions_verified",
            "designated_postconditions_verified"
          ]
        },
        "verification_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "method",
              "assertion",
              "test_id",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "read_system_of_record",
                  "independent_observation",
                  "human_confirmation",
                  "tool_return_code"
                ],
                "description": "tool_return_code is recorded for completeness but never counts as outcome verification on its own."
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "assertion": {
                "type": "string",
                "minLength": 1,
                "description": "Concrete observable condition, e.g. 'draft 48211-v1 exists with recipient domain on vendor file'."
              },
              "timeout_minutes": {
                "type": "integer",
                "minimum": 0
              },
              "test_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "description": "Stable ID unique within this operation."
              },
              "postcondition_index": {
                "type": "integer",
                "minimum": 0,
                "description": "Zero-based reference to expected_postconditions. Required for independent tests; validated at publication and containment."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "method": {
                      "enum": [
                        "read_system_of_record",
                        "independent_observation",
                        "human_confirmation"
                      ]
                    }
                  },
                  "required": [
                    "method"
                  ]
                },
                "then": {
                  "required": [
                    "postcondition_index"
                  ]
                }
              }
            ]
          },
          "minItems": 1
        },
        "on_failure": {
          "type": "string",
          "enum": [
            "reopen",
            "escalate",
            "recover",
            "rollback"
          ]
        },
        "max_observation_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum age at verification; observed_at must also be at or after the dispatch attempt ended and never in the future (zero clock-skew tolerance)."
        },
        "designated_test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Required only for designated_postconditions_verified. IDs must identify independent tests in this plan; non-designated results remain visible."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "completion_rule": {
                "const": "designated_postconditions_verified"
              }
            },
            "required": [
              "completion_rule"
            ]
          },
          "then": {
            "required": [
              "designated_test_ids"
            ]
          },
          "else": {
            "not": {
              "required": [
                "designated_test_ids"
              ]
            }
          }
        }
      ]
    },
    "recovery": {
      "type": "object",
      "description": "Decision 12 (recovery). How this specific action is undone or compensated, and whether that path has been exercised.",
      "required": [
        "method",
        "tested",
        "irreversible",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "tested": {
          "type": "boolean"
        },
        "last_tested": {
          "type": "string",
          "format": "date"
        },
        "time_to_recover_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "irreversible": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "tested_evidence_ref": {
          "type": "string",
          "description": "Reference to the test run that exercised this recovery path. Required for 'tested' to count."
        }
      }
    },
    "review_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "End of the human review window. Execution authority is separate and shorter (granted by the gate on ALLOW)."
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest of tool + operation + effect_target + parameters. The executed request must reproduce it."
    },
    "not_permitted_summary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Enforced prohibitions (structural or typed), copied verbatim from the Profile. These are what the Card may present as 'This agent can never'."
    },
    "built_by": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the gate that built this Manifest. A Manifest not built by the evaluating gate is refused."
    },
    "documented_not_enforced": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Prohibitions the Profile states but the gate does NOT enforce (documentation_only). Shown on the Card under a separate 'stated, not enforced' heading, never as 'can never'."
    },
    "program_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_id", "accountable_organization", "declared_purpose", "owner_principal"],
      "properties": {
        "program_id": {"type": "string", "minLength": 1},
        "accountable_organization": {"type": "string", "minLength": 1},
        "declared_purpose": {"type": "string", "minLength": 1},
        "owner_principal": {"type": "string", "minLength": 1}
      }
    },
    "execution_context_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "context_version", "context_digest", "attested_by"],
      "properties": {
        "context_id": {"type": "string", "minLength": 1},
        "context_version": {"type": "string", "minLength": 1},
        "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "attested_by": {"type": "string", "minLength": 1}
      }
    },
    "delegation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "root_profile_id", "depth"],
          "properties": {"mode": {"const": "root"}, "root_profile_id": {"type": "string", "minLength": 1}, "depth": {"const": 0}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "attestation_id", "parent_manifest_id", "parent_action_id", "root_profile_id", "depth", "attested_by", "expires_at"],
          "properties": {
            "mode": {"const": "attenuated"}, "attestation_id": {"type": "string", "minLength": 1},
            "parent_manifest_id": {"type": "string", "minLength": 1}, "parent_action_id": {"type": "string", "minLength": 1},
            "root_profile_id": {"type": "string", "minLength": 1}, "depth": {"type": "integer", "minimum": 1},
            "attested_by": {"type": "string", "minLength": 1}, "expires_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "aggregate_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "actor_group_id", "delegation_root_profile_id", "program_id", "target_digest", "claims", "review_snapshot"],
      "properties": {
        "policy_ref": {
          "type": "object", "additionalProperties": false, "required": ["policy_id", "policy_version", "policy_digest"],
          "properties": {"policy_id": {"type": "string"}, "policy_version": {"type": "string"}, "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
        },
        "actor_group_id": {"type": "string", "minLength": 1},
        "delegation_root_profile_id": {"type": "string", "minLength": 1},
        "program_id": {"type": "string", "minLength": 1},
        "target_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "claims": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["budget_id", "measure", "window", "limit", "on_exhaustion", "group", "group_digest", "amount"],
            "properties": {
              "budget_id": {"type": "string", "minLength": 1}, "measure": {"enum": ["admissions", "in_flight", "objects", "distinct_targets", "egress_bytes"]},
              "window": {"type": "object"}, "limit": {"type": "integer", "minimum": 1},
              "on_exhaustion": {"enum": ["DENY", "REQUIRE_APPROVAL", "SUSPENDED"]},
              "group": {"type": "object", "additionalProperties": {"type": "string"}},
              "group_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "amount": {"type": "integer", "minimum": 0}
            }
          }
        },
        "review_snapshot": {
          "type": "object", "additionalProperties": false, "required": ["issues", "revision"],
          "properties": {"issues": {"type": "array", "items": {"type": "string"}}, "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
        }
      }
    },
    "campaign_context": {
      "type": "object", "additionalProperties": false, "required": ["mode", "holds", "revision"],
      "properties": {
        "mode": {"enum": ["NORMAL", "REQUIRE_APPROVAL", "SUSPENDED"]},
        "holds": {"type": "array", "items": {"type": "object"}},
        "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "operational_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "policy_digest",
        "mode",
        "control_revision",
        "restrictions",
        "adapter_revision"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mode": {

  <diagram id="aam-results" name="2. Results at the trusted gate">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1635" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;div style=&quot;font-size:34px;line-height:1.25;color:#15324C;font-weight:700;&quot;&gt;Results at the trusted gate&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#15324C;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="2160" height="52"/>
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;font-size:19px;line-height:1.25;color:#4A6075;font-weight:400;&quot;&gt;A receipt, an observation and a reconciliation result answer different questions. No returned value is permission to repeat an action.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#4A6075;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="87" width="2160" height="50"/>
        </mxCell>
        <mxCell id="axisa" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;AUTHORIZATION&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;May this exact action be attempted?&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F4F6F8;strokeColor=#A9B5C3;fontColor=#283B50;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="150" width="690" height="89"/>
        </mxCell>
        <mxCell id="axisb" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;EXECUTION + OUTCOME&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;What was attempted, and was its result verified?&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F4F6F8;strokeColor=#A9B5C3;fontColor=#283B50;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="150" width="690" height="89"/>
        </mxCell>
        <mxCell id="axisc" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;OPERATING MODE&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;What restrictions apply to future admissions?&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F4F6F8;strokeColor=#A9B5C3;fontColor=#283B50;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="150" width="690" height="89"/>
        </mxCell>
        <mxCell id="h0" value="&lt;div style=&quot;font-size:17px;line-height:1.25;color:#42576B;font-weight:700;&quot;&gt;RESULT / EVIDENCE&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#42576B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="269" width="390" height="27"/>
        </mxCell>
        <mxCell id="h1" value="&lt;div style=&quot;font-size:17px;line-height:1.25;color:#42576B;font-weight:700;&quot;&gt;WHAT THE TRUSTED GATE DOES&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#42576B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="269" width="660" height="27"/>
        </mxCell>
        <mxCell id="h2" value="&lt;div style=&quot;font-size:17px;line-height:1.25;color:#42576B;font-weight:700;&quot;&gt;RECORDED MEANING&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#42576B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1215" y="269" width="430" height="27"/>
        </mxCell>
        <mxCell id="h3" value="&lt;div style=&quot;font-size:17px;line-height:1.25;color:#42576B;font-weight:700;&quot;&gt;FEEDBACK CONSEQUENCE&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#42576B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1700" y="269" width="485" height="27"/>
        </mxCell>
        <mxCell id="in0" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Normal adapter return&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;A valid, serializable receipt&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#EDF7EF;strokeColor=#63A173;fontColor=#254D30;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="310" width="390" height="137"/>
        </mxCell>
        <mxCell id="handle0" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Gate handling&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Record acknowledgment; await a separate verification call.&lt;br&gt;A successful tool return is not evidence that business postconditions hold.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#E7F7F6;strokeColor=#28918B;fontColor=#154A47;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="310" width="660" height="137"/>
        </mxCell>
        <mxCell id="state0" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Record / status&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;execution_state = ACKNOWLEDGED&lt;br&gt;Outcome not yet established.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F1EEFF;strokeColor=#8A77B3;fontColor=#3C2E64;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1215" y="310" width="430" height="137"/>
        </mxCell>
        <mxCell id="feedback0" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Signal / restriction&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;No general success-to-permission rule.&lt;br&gt;Existing restrictions are not cleared.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#EDF7EF;strokeColor=#63A173;fontColor=#254D30;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1700" y="310" width="485" height="137"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#58718B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="in0" target="handle0">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8A77B3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="handle0" target="state0">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C29738;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="state0" target="feedback0">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="in1" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Explicit no-attempt signal&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;ExecutorNotAttempted&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F4F6F8;strokeColor=#A9B5C3;fontColor=#283B50;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="474" width="390" height="137"/>
        </mxCell>
        <mxCell id="handle1" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Gate handling&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Record the trusted adapter’s assertion that no downstream attempt occurred.&lt;br&gt;Keep the action reservation and any consumed approval.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#E7F7F6;strokeColor=#28918B;fontColor=#154A47;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="474" width="660" height="137"/>
        </mxCell>
        <mxCell id="state1" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Record / status&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;execution_state = NOT_ATTEMPTED&lt;br&gt;No automatic retry or approval restoration.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F1EEFF;strokeColor=#8A77B3;fontColor=#3C2E64;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1215" y="474" width="430" height="137"/>

  <diagram id="aam-feedback" name="3. Aggregate and governed restriction">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1670" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;div style=&quot;font-size:34px;line-height:1.25;color:#15324C;font-weight:700;&quot;&gt;Aggregate budgets and governed restrictions&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=34;fontColor=#15324C;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="2160" height="52"/>
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;font-size:19px;line-height:1.25;color:#4A6075;font-weight:400;&quot;&gt;The fast loop applies existing rules. The slower improvement loop changes software or policy only through reviewed, versioned release.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#4A6075;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="87" width="2160" height="50"/>
        </mxCell>
        <mxCell id="fast-h" value="&lt;b&gt;A  FAST PROTECTION UNDER REVIEWED RULES&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=21;fontColor=#42576B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="158" width="2100" height="28"/>
        </mxCell>
        <mxCell id="life" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Gate-owned lifecycle signals&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Execution uncertainty, evidence conflict&lt;br&gt;and failed / unavailable verification&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#EDF7EF;strokeColor=#63A173;fontColor=#254D30;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="215" width="440" height="122"/>
        </mxCell>
        <mxCell id="external" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Authenticated host observations&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Examples: compromised runtime or session;&lt;br&gt;vulnerable or revoked tool, plugin or connector.&lt;br&gt;Host maps evidence to supported typed inputs;&lt;br&gt;checks source, affected version and scope.&lt;br&gt;No built-in compromise detectors.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#EAF2FF;strokeColor=#527BA7;fontColor=#123555;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="195" width="535" height="177"/>
        </mxCell>
        <mxCell id="watch" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Host-scheduled watchdog&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Overdue execution or verification&lt;br&gt;Host calls watchdog(); no background service&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#EAF2FF;strokeColor=#527BA7;fontColor=#123555;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1125" y="215" width="500" height="122"/>
        </mxCell>
        <mxCell id="pol" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Reviewed aggregate and feedback policies&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Budgets use trusted grouping and windows.&lt;br&gt;Lifecycle rules count distinct execution incidents;&lt;br&gt;campaign rules count distinct observation IDs.&lt;br&gt;Exact policy digests are pinned by the Profile.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F1EEFF;strokeColor=#8A77B3;fontColor=#3C2E64;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1680" y="202" width="510" height="172"/>
        </mxCell>
        <mxCell id="bind" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;1. Create attributable signal events&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Preserve record identity and scope.&lt;br&gt;Do not treat log text or model output as instructions.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#E7F7F6;strokeColor=#28918B;fontColor=#154A47;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="463" width="440" height="145"/>
        </mxCell>
        <mxCell id="rules" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;2. Evaluate reviewed rules&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Deduplicate the IDs supported by each path.&lt;br&gt;Match signal, threshold, window and scope.&lt;br&gt;Repeated observations need host incident mapping.&lt;br&gt;No matching rule: no new restriction.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#E7F7F6;strokeColor=#28918B;fontColor=#154A47;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="453" width="535" height="165"/>
        </mxCell>
        <mxCell id="holds" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;3. Record independent restrictions&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Activate a hold + revision + cause.&lt;br&gt;Applicable holds compose; strongest mode wins.&lt;br&gt;Separate causes are not one resettable switch.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#FFF4DE;strokeColor=#CB9A3B;fontColor=#674813;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1125" y="453" width="500" height="165"/>
        </mxCell>
        <mxCell id="next" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;4. Check every new admission&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Baseline Profile and approval checks always apply.&lt;br&gt;Budget excess: DENY, REQUIRE_APPROVAL or&lt;br&gt;SUSPENDED, as the reviewed policy specifies.&lt;br&gt;Active feedback and campaign holds also apply.&lt;br&gt;Aggregate usage is checked before dispatch.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#E7F7F6;strokeColor=#28918B;fontColor=#154A47;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1680" y="435" width="510" height="203"/>
        </mxCell>

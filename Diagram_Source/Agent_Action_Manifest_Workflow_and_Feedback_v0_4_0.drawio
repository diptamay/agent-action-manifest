        </mxCell>
        <mxCell id="in5" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Required test has conflicting evidence&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Admissible TRUE and FALSE for the same test&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#FFF0EE;strokeColor=#C9786E;fontColor=#71322B;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="1130" width="390" height="137"/>
        </mxCell>
        <mxCell id="handle5" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Gate handling&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Retain both evidence paths; no source silently wins.&lt;br&gt;Withhold completion for the required test.&lt;br&gt;Keep outcome uncertainty separate from dispatch uncertainty.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#E7F7F6;strokeColor=#28918B;fontColor=#154A47;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="1130" width="660" height="137"/>
        </mxCell>
        <mxCell id="state5" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Record / status&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;test evidence_conflict = true&lt;br&gt;verified = false for a required test&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F1EEFF;strokeColor=#8A77B3;fontColor=#3C2E64;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1215" y="1130" width="430" height="137"/>
        </mxCell>
        <mxCell id="feedback5" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Signal / restriction&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;EVIDENCE_CONFLICT&lt;br&gt;Any test conflict takes signal precedence.&lt;br&gt;Completion fails when a required test conflicts.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#FFF0EE;strokeColor=#C9786E;fontColor=#71322B;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">

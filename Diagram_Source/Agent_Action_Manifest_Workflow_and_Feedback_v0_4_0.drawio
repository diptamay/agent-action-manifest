        <mxCell id="workflow-note" value="&lt;div style=&quot;font-size:18px;line-height:1.25;color:#4A6075;font-weight:400;&quot;&gt;This bottom row is the human/deployer-owned improvement workflow. The reference supplies case extraction, not an automated deployment pipeline.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#4A6075;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1482.0" width="2130" height="40"/>
        </mxCell>
        <mxCell id="boundary" value="&lt;div style=&quot;font-size:18px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Standing authority never expands through feedback.&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.28;&quot;&gt;A successful reconciliation or verified outcome changes the action’s evidence/state. It does not clear an operational hold. Restoration and reviewed release are separate paths.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F4F6F8;strokeColor=#A9B5C3;fontColor=#283B50;fontFamily=Helvetica;fontSize=17;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1530.0" width="2140" height="85"/>
        </mxCell>
        <mxCell id="footer" value="Source: audit.py, aggregate.py, feedback.py, managed_gate.py and v4.py. Host authentication, evidence, detectors and campaign restoration safeguards remain deployment responsibilities." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#58718B;" vertex="1" parent="1">

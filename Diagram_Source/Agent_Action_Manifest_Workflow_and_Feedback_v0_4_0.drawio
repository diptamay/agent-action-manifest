  <diagram id="aam-workflow" name="1. High-level workflow">
    <mxGraphModel dx="1320" dy="839" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="790" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=32;fontColor=#17384B;fontStyle=1;spacing=0;" value="Agent Action Manifest" vertex="1">
          <mxGeometry height="45" width="1150" x="45" y="25" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=18;fontColor=#4A6075;fontStyle=0;spacing=0;" value="People set authority. Agents request. The trusted gate governs each action." vertex="1">
          <mxGeometry height="30" width="1150" x="45" y="78" as="geometry"/>
        </mxCell>
        <mxCell id="owners" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#F2F0FA;strokeColor=#B4A7D6;fontFamily=Arial;fontSize=17;fontColor=#17384B;" value="&lt;b&gt;Product + engineering owners&lt;/b&gt;&lt;br&gt;Review the Authority Profile,&lt;br&gt;aggregate and feedback policies." vertex="1">
          <mxGeometry height="95" width="360" x="45" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="approver" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#F0F5FC;strokeColor=#A6C3E7;fontFamily=Arial;fontSize=17;fontColor=#17384B;" value="&lt;b&gt;Human approver&lt;/b&gt;&lt;br&gt;Reviews the exact Card / Manifest;&lt;br&gt;approves or rejects, when required." vertex="1">
          <mxGeometry height="95" width="350" x="620" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="agent" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#F0F5FC;strokeColor=#A6C3E7;fontFamily=Arial;fontSize=17;fontColor=#17384B;" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;Submits an Action Request.&lt;br&gt;Runtime, tools and session&lt;br&gt;may be compromised." vertex="1">
          <mxGeometry height="145" width="275" x="45" y="335" as="geometry"/>
        </mxCell>
        <mxCell id="gate" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#E8F4F4;strokeColor=#279B9B;fontFamily=Arial;fontSize=17;fontColor=#17384B;" value="&lt;b&gt;Trusted gate&lt;/b&gt;&lt;br&gt;Holds consequential credentials.&lt;br&gt;Builds the Action Manifest.&lt;br&gt;Checks authority, context and budgets.&lt;br&gt;Records admission before dispatch.&lt;br&gt;Only ALLOW may dispatch." vertex="1">
          <mxGeometry height="185" width="410" x="390" y="320" as="geometry"/>
        </mxCell>
        <mxCell id="executor" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#F1F6F2;strokeColor=#9FC9A5;fontFamily=Arial;fontSize=17;fontColor=#17384B;" value="&lt;b&gt;Executor + verifier&lt;/b&gt;&lt;br&gt;Acts on the target.&lt;br&gt;Returns receipt and&lt;br&gt;independent evidence." vertex="1">
          <mxGeometry height="135" width="270" x="920" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="feedback" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#FFF5E8;strokeColor=#E1B160;fontFamily=Arial;fontSize=17;fontColor=#17384B;" value="&lt;b&gt;Aggregate and feedback controls&lt;/b&gt;&lt;br&gt;Apply reviewed, restrictive rules." vertex="1">
          <mxGeometry height="95" width="410" x="390" y="595" as="geometry"/>
        </mxCell>
        <mxCell id="published" edge="1" parent="1" source="owners" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#486979;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2073170731707317;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=4 3;" target="gate">

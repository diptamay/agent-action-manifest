        <mxCell id="in4" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Required evidence fails / is unavailable&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;False, missing, invalid or stale observation&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#FFF4DE;strokeColor=#CB9A3B;fontColor=#674813;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="966" width="390" height="137"/>
        </mxCell>
        <mxCell id="handle4" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Gate handling&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Do not claim completion. Retain test results and route the recorded failure&lt;br&gt;as specified by the Manifest. Rechecking is host-driven.&lt;br&gt;Recovery actions are not executed automatically.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#E7F7F6;strokeColor=#28918B;fontColor=#154A47;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="966" width="660" height="137"/>
        </mxCell>
        <mxCell id="state4" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Record / status&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;verified = false&lt;br&gt;completion = configured on_failure&lt;br&gt;(e.g. escalate)&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F1EEFF;strokeColor=#8A77B3;fontColor=#3C2E64;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">

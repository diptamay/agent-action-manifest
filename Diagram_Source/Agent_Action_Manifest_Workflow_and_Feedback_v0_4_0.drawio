        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C29738;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="state5" target="feedback5">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="recon-panel" value="&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.25;&quot;&gt;RECONCILIATION IS A SEPARATE, READ-ONLY PATH OUT OF EXECUTION_UNKNOWN&lt;/div&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F7FAF8;strokeColor=#A8C6AD;fontFamily=Helvetica;fontSize=20;fontColor=#334D65;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1320" width="2160" height="245"/>
        </mxCell>
        <mxCell id="rc" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Terminal COMMITTED&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Bind evidence to execution + idempotency key.&lt;br&gt;Record settlement, then verify business outcomes.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#EDF7EF;strokeColor=#63A173;fontColor=#254D30;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1390" width="665" height="113"/>
        </mxCell>
        <mxCell id="rn" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Terminal NOT_COMMITTED&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Record no commit; do not call it NOT_ATTEMPTED.&lt;br&gt;Reservation remains; no retry is authorized.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#FFF4DE;strokeColor=#CB9A3B;fontColor=#674813;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="785" y="1390" width="665" height="113"/>
        </mxCell>
        <mxCell id="ru" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;UNKNOWN / invalid / stale result&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Remain unresolved. Reject delayed settlement&lt;br&gt;if the execution snapshot has already changed.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F4F6F8;strokeColor=#A9B5C3;fontColor=#283B50;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="1390" width="665" height="113"/>
        </mxCell>
        <mxCell id="recon-note" value="&lt;div style=&quot;font-size:17px;line-height:1.25;color:#425F49;font-weight:700;&quot;&gt;Neither reconciliation nor verified success restores a consumed approval, clears a separate runtime restriction, or redispatches an action.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#425F49;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="1518" width="2090" height="29"/>
        </mxCell>
        <mxCell id="footer" value="&lt;div style=&quot;font-size:14px;line-height:1.25;color:#58718B;font-weight:400;&quot;&gt;Source: v0.4.0 gate.py execute(), verify_outcome(), reconcile(); audit.py changes().  |  RuntimeFailure is a separate persistence fault, not proof of no downstream effect.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#58718B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1592" width="2160" height="28"/>
        </mxCell>

        <mxCell id="results" edge="1" parent="1" source="executor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#486979;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0;exitY=0.7777777777777778;exitDx=0;exitDy=0;entryX=1;entryY=0.7297297297297297;entryDx=0;entryDy=0;" target="gate">

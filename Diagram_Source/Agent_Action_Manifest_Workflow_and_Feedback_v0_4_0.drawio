        <mxCell id="feedback4" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Signal / restriction&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;VERIFICATION_FAILED&lt;br&gt;Rules count distinct incidents in a window;&lt;br&gt;a missing observation also falls in this category.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#FFF4DE;strokeColor=#CB9A3B;fontColor=#674813;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">

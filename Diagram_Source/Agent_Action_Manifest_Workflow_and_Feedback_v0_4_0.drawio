        </mxCell>
      <mxCell id="trusted-host" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#F2F0FA;strokeColor=#B4A7D6;fontFamily=Arial;fontSize=17;fontColor=#17384B;" value="&lt;b&gt;Trusted host&lt;/b&gt;&lt;br&gt;Authenticates caller and context.&lt;br&gt;Pins reviewed versions.&lt;br&gt;Attests delegation if allowed.&lt;br&gt;Enforces credential isolation."><mxGeometry x="45" y="530" width="290" height="170" as="geometry"/></mxCell><mxCell id="host-context" edge="1" parent="1" source="trusted-host" target="gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#486979;strokeWidth=1.7;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.85;dashed=1;dashPattern=4 3;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="615"/><mxPoint x="360" y="477.25"/></Array></mxGeometry></mxCell></root>

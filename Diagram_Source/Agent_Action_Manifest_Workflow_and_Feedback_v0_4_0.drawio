        <mxCell id="in3" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Required postconditions pass&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Fresh, bound, admissible evidence&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#EDF7EF;strokeColor=#63A173;fontColor=#254D30;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="802" width="390" height="137"/>
        </mxCell>
        <mxCell id="handle3" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Gate handling&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Apply the declared all-postconditions or designated-test plan.&lt;br&gt;Complete only if execution is ACKNOWLEDGED or COMMITTED.&lt;br&gt;With UNKNOWN, positive observations do not settle the dispatch.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#E7F7F6;strokeColor=#28918B;fontColor=#154A47;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="802" width="660" height="137"/>
        </mxCell>
        <mxCell id="state3" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Record / status&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;verified = true; completion = complete&lt;br&gt;ONLY with eligible execution state.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#F1EEFF;strokeColor=#8A77B3;fontColor=#3C2E64;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1215" y="802" width="430" height="137"/>
        </mxCell>
        <mxCell id="feedback3" value="&lt;div style=&quot;font-size:19px;font-weight:700;line-height:1.2;margin-bottom:8px;&quot;&gt;Signal / restriction&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.28;&quot;&gt;Record the outcome.&lt;br&gt;Do not automatically remove holds,&lt;br&gt;grant permissions or approve another action.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=15;fillColor=#EDF7EF;strokeColor=#63A173;fontColor=#254D30;fontFamily=Helvetica;fontSize=18;strokeWidth=1.6;" vertex="1" parent="1">
